[Unit]
Description=Collect anonymous website engagement to Olares
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=olares
Group=olares
UMask=0077
ExecStart=/usr/bin/python3 /home/olares/jeffseah-engagement/collect.py
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/olares/jeffseah-engagement /home/olares/coach
